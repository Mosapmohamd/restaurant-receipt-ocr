# Optional overrides for vlm-pipeline/config.py (read with os.getenv; export them in your shell).
# No API keys are needed — everything runs against a local Ollama instance.
OLLAMA_URL=http://localhost:11434/api/chat
MODEL_NAME=MedAIBase/PaddleOCR-VL:0.9b
CONFIDENCE_THRESHOLD=0.6
OLLAMA_TIMEOUT_SECONDS=300
MAX_WORKERS=4
RETRY_ATTEMPTS=3
SAVE_DEBUG_ARTIFACTS=1
MAX_IMAGE_WIDTH=2000
MAX_IMAGE_HEIGHT=2000
